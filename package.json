{
  "name": "shopnest-storefront",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ShopNest - a production-quality, backend-ready e-commerce frontend built with React, Vite and Material UI.",
  "scripts": {
    "dev": "vite",
    "dev:backend": "npm run start --prefix backend",
    "dev:all": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run start --prefix backend\" \"vite\"",
    "seed": "npm run seed --prefix backend",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint ."
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^5.16.7",
    "@mui/lab": "^5.0.0-alpha.173",
    "@mui/material": "^5.16.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.5",
    "vite": "^5.4.8"
  }
}
